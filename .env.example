# App
APP_PORT=8080
APP_ENV=local
DB_PATH=data/youtube_scripts.db
# Verified SQLite backups are stored here. The app never deletes them automatically.
# Keep this OUTSIDE the container's data volume so a host disk failure cannot
# take the database and its backups at the same time. See docs/agent-api.md.
DB_BACKUP_DIR=data/backups

# Network access
# ---------------------------------------------------------------------------
# The app refuses to start without this. It was previously reachable on the LAN
# with no authentication at all, including a DELETE endpoint.
# Generate one with: openssl rand -hex 32
#
# Browsers authenticate with HTTP Basic (any username, this token as password)
# and then receive an HttpOnly cookie for the websocket. Agents and scripts use
# `Authorization: Bearer <token>`.
APP_AUTH_TOKEN=
# Escape hatch: set to 1 to serve without authentication. Only for a host that
# is genuinely unreachable from other machines.
# APP_AUTH_DISABLED=1

# Agent API (/api/agent/v1). Registration is refused once this many jobs are
# already queued, so a loop cannot flood the paid LLM pipeline. 0 disables the cap.
AGENT_MAX_QUEUED=5

# LLM provider
# Available values, in Settings display order:
#   openai, azure, openrouter, gemini, codex_subscription, kiro
LLM_PROVIDER=azure

# Each provider has separate models for summarization and translation.
# *_MODEL is the legacy/default fallback. *_SUMMARY_MODEL and
# *_TRANSLATION_MODEL are used by the corresponding tasks.

# 1. OpenAI API
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_SUMMARY_MODEL=gpt-5.4-mini
OPENAI_TRANSLATION_MODEL=gpt-5.4-mini

# 2. Azure OpenAI
# The endpoint may be the resource URL or its complete /openai/v1 base URL.
AZURE_API_KEY=your-azure-api-key
AZURE_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_REGION=eastus2
# For an Azure AI Foundry resource, use:
# AZURE_ENDPOINT=https://your-project.services.ai.azure.com
AZURE_MODEL=gpt-5.4-nano
AZURE_SUMMARY_MODEL=gpt-5.4-nano
AZURE_TRANSLATION_MODEL=gpt-5.4-nano

# 3. OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-5.4-mini
OPENROUTER_SUMMARY_MODEL=openai/gpt-5.4-mini
OPENROUTER_TRANSLATION_MODEL=openai/gpt-5.4-mini

# 4. Google Gemini through its OpenAI-compatible endpoint
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_SUMMARY_MODEL=gemini-3.5-flash
GEMINI_TRANSLATION_MODEL=gemini-3.5-flash

# 5. Codex using ChatGPT-managed subscription login (no API key required)
# Install the Codex app/CLI, then connect from the Settings menu.
CODEX_MODEL=gpt-5.6-terra
CODEX_SUMMARY_MODEL=gpt-5.6-terra
CODEX_TRANSLATION_MODEL=gpt-5.6-luna
# Optional when the codex executable is not on PATH:
# CODEX_BIN=C:\\path\\to\\codex.exe
CODEX_START_TIMEOUT=15
CODEX_REQUEST_TIMEOUT=180

# 6. Kiro Gateway
# For local Windows execution, localhost is usually correct.
# For Docker accessing a gateway on the host, use http://host.docker.internal:4000/v1.
KIRO_BASE_URL=http://localhost:4000/v1
KIRO_API_KEY=kiro-local
KIRO_MODEL=claude-haiku-4-5
KIRO_SUMMARY_MODEL=claude-haiku-4-5
KIRO_TRANSLATION_MODEL=claude-haiku-4-5
